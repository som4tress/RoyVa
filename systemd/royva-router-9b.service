[Unit]
Description=RoyVa router model: Qwen3.5-9B Q8 (primary intent classifier, port 8203)
After=network-online.target
PartOf=royva.target

[Service]
Type=simple
ExecStart=/home/somdutta/RoyVa/scripts/run-router-model.sh llm Qwen3.5-9B-Q8_0.gguf 8203
Restart=on-failure
RestartSec=5

[Install]
WantedBy=royva.target
