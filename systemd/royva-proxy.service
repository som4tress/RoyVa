[Unit]
StartLimitIntervalSec=0
Description=RoyVa logging proxy (llama.cpp pass-through, request capture)
After=network-online.target evo-llamacpp-agent.service
Wants=evo-llamacpp-agent.service
PartOf=royva.target

[Service]
Type=simple
ExecStart=/home/somdutta/RoyVa/scripts/run-proxy.sh
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=royva.target
