[Unit]
Description=EVO vLLM vision endpoint
StartLimitIntervalSec=600
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=/home/somdutta/llm-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/somdutta/llm-server/launch.py vision
ExecStop=-/usr/bin/docker stop -t 30 evo-vllm-vision
ExecStartPost=/usr/bin/python3 /home/somdutta/llm-server/wait_ready.py 8001
TimeoutStartSec=900
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=default.target
